# Copy to .env for LOCAL testing only. .env is gitignored — never commit real secrets.

# --- Govee (required) ---
GOVEE_API_KEY=your-govee-api-key-here
GOVEE_DEVICE_SKU=H5103
GOVEE_DEVICE_ID=AB:CD:EF:12:34:56:78:90

# --- Display / alerting ---
TEMP_UNIT=C
ALERT_THRESHOLD_C=30
ALERT_RECOVERED=1

# --- Email alerts (Gmail app password, NOT your normal password) ---
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
ALERT_TO=you@gmail.com,it-partner@example.com
# Optional overrides:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
